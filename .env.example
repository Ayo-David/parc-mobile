# Copy to .env for local development. Never commit the real .env file.

# Single public origin the app talks to, through Kong, already including the
# /mobile prefix per mobile-flow-map.md §3.1. Requests go to
# `${EXPO_PUBLIC_API_BASE_URL}/v1/...`.
# Shared dev server: https://api.parc.name.ng/mobile
# Local compose stack: http://localhost:18000/mobile
EXPO_PUBLIC_API_BASE_URL=https://api.parc.name.ng/mobile

# Branded tenant slug sent as X-Tenant-Slug on the bootstrap call.
# Must match an existing tenant's lowercased tenant_code in parc-tenant-admin.
# The PR-01 fixture tenants are pr01-tenant-a / pr01-tenant-b; an unknown slug
# surfaces as a 502 DEPENDENCY_UNAVAILABLE from the Mobile BFF.
EXPO_PUBLIC_TENANT_SLUG=pr01-tenant-a

# Optional. Sentry is a no-op until a real DSN is supplied.
EXPO_PUBLIC_SENTRY_DSN=

# DEV-ONLY WORKAROUND (see src/app/savings/fixed-deposits/create.tsx): no
# endpoint lists published savings products, so a fixed-deposit
# product_version_id must be supplied manually in development builds.
EXPO_PUBLIC_DEV_FIXED_DEPOSIT_PRODUCT_VERSION_ID=
