# Copy to .env for local development. Never commit the real .env file.

# Single public origin the app talks to, through Kong, already including the
# /mobile prefix per mobile-flow-map.md §3.1. Requests go to
# `${EXPO_PUBLIC_API_BASE_URL}/v1/...`.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/mobile

# Branded tenant slug sent as X-Tenant-Slug on the bootstrap call.
EXPO_PUBLIC_TENANT_SLUG=parc

# Optional. Sentry is a no-op until a real DSN is supplied.
EXPO_PUBLIC_SENTRY_DSN=

# DEV-ONLY WORKAROUND (see src/features/onboarding/consent.ts): comma-separated
# consent-document UUIDs for a seeded dev tenant. No public endpoint exists yet
# to discover these for real. Never set this in a production build.
EXPO_PUBLIC_DEV_CONSENT_IDS=

# DEV-ONLY WORKAROUND (see src/features/accounts/devSourceAccount.ts): the
# customer's own ledger/wallet account UUID. No endpoint anywhere returns this
# to the client yet (confirmed gap, blocks transfers and bills). Never set
# this in a production build.
EXPO_PUBLIC_DEV_SOURCE_ACCOUNT_ID=
